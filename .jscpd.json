{
  "threshold": 3,
  "minLines": 5,
  "minTokens": 50,
  "reporters": ["console"],
  "output": "reports/jscpd",
  "ignore": [
    "**/node_modules/**",
    "**/.svelte-kit/**",
    "**/build/**",
    "**/dist/**",
    "**/coverage/**",
    "**/reports/**",
    "**/.stryker-tmp/**",
    "**/src/lib/components/ui/**",
    "**/docs/**",
    "**/.agents/**",
    "**/pnpm-lock.yaml"
  ]
}
